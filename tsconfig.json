{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "types": ["node"],

    // The Python side runs mypy --strict. This is the same bar: every one of
    // these catches a class of bug the ported code could otherwise carry, and
    // the port was written under them rather than loosened to fit.
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    "declaration": true,
    "sourceMap": true,
    "skipLibCheck": true,

    // Imports are written with the real `.ts` extension, so `node --experimental-
    // strip-types` runs the sources directly with no build step, and `tsc`
    // rewrites them to `.js` on the way into dist/.
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts", "evals/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "dist", "frontend"]
}

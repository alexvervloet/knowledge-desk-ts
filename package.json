{
  "name": "knowledge-desk",
  "version": "0.0.1",
  "description": "Multi-tenant, permissions-aware knowledge assistant",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware src evals",
    "dev": "node --watch --experimental-strip-types src/server.ts",
    "start": "node dist/server.js",
    "worker": "node --experimental-strip-types src/worker.ts",
    "migrate": "node --experimental-strip-types src/migrate.ts",
    "seed": "node --experimental-strip-types src/seed.ts",
    "bench": "node --experimental-strip-types src/bench.ts",
    "evals": "node --experimental-strip-types evals/run.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/static": "^10.1.3",
    "@node-rs/bcrypt": "^1.10.9",
    "fastify": "^5.12.4",
    "pg": "^8.23.0",
    "pgvector": "^0.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/pg": "^8.15.5",
    "@vitest/coverage-v8": "^5.0.0",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}

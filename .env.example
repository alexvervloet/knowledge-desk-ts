# Copy to .env for local dev. .env is gitignored. Nothing here is a real secret:
# the provider keys are left unset on purpose, so a fresh clone runs against the
# mock provider and needs no accounts. Keep real keys out of the file — export
# them from whatever secret store you already use.

# Local pgvector from docker-compose (host port 5437).
# DATABASE_URL is the owner role: migrations, DDL, preflight.
# APP_DATABASE_URL is the least-privilege app role the runtime uses, so row-level
# security applies to it (a superuser/owner would bypass RLS). The kd_app role is
# created by migration 0007.
DATABASE_URL=postgresql://kd:kd@localhost:5437/knowledge_desk
APP_DATABASE_URL=postgresql://kd_app:kd_app@localhost:5437/knowledge_desk

# Provider keys are unset by default, so the app runs in the loud mock fallback.
# Set both to switch to the real provider.
# ANTHROPIC_API_KEY=
# VOYAGE_API_KEY=

# Set to 1 to refuse startup instead of falling back to the mock provider.
PROVIDER_STRICT=0

# Spend and abuse controls. The per-org caps (DAILY_BUDGET_USD,
# MONTHLY_QUESTION_CAP) bound one tenant; PLATFORM_DAILY_BUDGET_USD bounds the
# whole deployment, which is the only one that holds while signup is open.
# PLATFORM_DAILY_BUDGET_USD=25.0

# Login and signup are throttled per caller address. Behind a proxy the socket
# peer is the proxy, so name the header carrying the real client address — but
# only one the proxy overwrites on the way in, or callers can forge their own
# bucket. Unset locally.
# CLIENT_IP_HEADER=Fly-Client-IP
# AUTH_RATE_BURST=10
# AUTH_RATE_PER_MIN=10

# Observability (optional). With no Langfuse keys, tracing is a no-op; the app
# runs unchanged. One trace per question, tagged by org and user.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
# Note the name: the Python SDK reads LANGFUSE_HOST, the JavaScript one reads
# LANGFUSE_BASE_URL and ignores LANGFUSE_HOST without saying so. Set the wrong one
# and traces go to cloud.langfuse.com while you believe you are self-hosting.
